# Normalise line endings to LF in both the repository and the working tree, so
# a Windows checkout agrees with .editorconfig and .prettierrc. Without this,
# core.autocrlf rewrites files to CRLF on checkout and `npm run format:check`
# fails on a clean clone.
* text=auto eol=lf

# Never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

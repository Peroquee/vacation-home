{
  "name": "vacation-home",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-messages.mjs && next build",
    "start": "next start",
    "lint": "eslint && node scripts/check-messages.mjs",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run -c vitest.db.config.mts",
    "test:e2e": "playwright test",
    "migrate:dev": "prisma migrate dev",
    "postmigrate:dev": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "guests:repurge": "tsx scripts/guests-repurge.ts",
    "tokens:rotate": "tsx scripts/tokens-rotate.ts",
    "audit": "node scripts/audit.mjs",
    "db:generate": "prisma generate",
    "prepare": "husky || echo \"husky not installed, skipping git hooks\"",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@base-ui/react": "^1.8.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sentry/nextjs": "11.6.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "4.14.6",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-is": "19.2.8",
    "recharts": "3.10.1",
    "sonner": "^2.0.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@next/env": "16.3.8",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^24.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "30.1.2",
    "lint-staged": "^17.5.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.6",
    "prisma": "7.10.0",
    "shadcn": "^4.21.3",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "mysql2": "3.24.5"
  }
}

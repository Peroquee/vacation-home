# Copy this file to `.env` and replace every "replace-me" value.
#
# The placeholders below are deliberately valid, so that `cp .env.example .env`
# is enough to get `npm run dev` running before Google OAuth exists. They are
# rejected outright when NODE_ENV is production - see src/env.ts.
#
# Every variable is validated against a schema at boot. The app refuses to
# start if any is missing or malformed, naming the offending variable.

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string, used by the app and the Prisma CLI. The host
# port is the one docker-compose.yml publishes, deliberately not 5432 so it
# cannot clash with a local PostgreSQL install. The app container overrides
# this with db:5432.
DATABASE_URL="postgresql://vacation:vacation@localhost:5433/vacation_home"

# --- Authentication ---------------------------------------------------------
# Session signing key, at least 32 characters. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-me-with-at-least-32-random-characters"

# Google OAuth client credentials, a "Web application" client from the Google
# Cloud console. The same client serves sign-in and Google Calendar.
# Step by step: docs/google-cloud-setup.md.
AUTH_GOOGLE_ID="replace-me.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="replace-me"

# The Google accounts allowed to sign in, comma-separated, e.g.
# "owner@gmail.com,partner@gmail.com". Anyone else is turned away at sign-in,
# and removing an address here signs that account out on its next request.
# In the Google client, the authorised redirect URI is
#   <APP_URL>/api/auth/callback/google
AUTH_ALLOWED_EMAILS="replace-me@example.com"

# --- Application ------------------------------------------------------------
# Public base URL of this app. OAuth redirect URIs are derived from it, so it
# must match what is registered in the Google client.
APP_URL="http://localhost:3000"
# Optional: where sign-in builds its own URLs, if that ever has to differ from
# APP_URL. Leave it empty: APP_URL is used, also behind a reverse proxy
# (Caddy, tailscale serve), where the app cannot see its public address.
AUTH_URL=""

# --- Google Calendar ------------------------------------------------------------
# Key that encrypts Google tokens at rest: 32 random bytes, base64. Optional;
# without it, connecting Google Calendar is unavailable. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or changing it means reconnecting Google Calendar.
# Add <APP_URL>/api/google/callback as a redirect URI of the Google client too.
TOKEN_ENCRYPTION_KEY=""
# How often each synced calendar is checked for changes, in seconds (min 60).
# During a key rotation only: the previous TOKEN_ENCRYPTION_KEY values,
# comma-separated (see docs/security.md, "Rotating the token key").
TOKEN_ENCRYPTION_KEYS_OLD=""
GOOGLE_CALENDAR_POLL_SECONDS=""

# --- iCal feeds ---------------------------------------------------------------
# Minutes between fetches of each booking platform's iCal feed (Airbnb,
# Booking.com, ...), set up per property in Settings. At least 5; default 30.
ICAL_POLL_MINUTES=""
# Optional public address for the iCal export links shown in Settings, e.g.
# "https://calendar.example.com" behind a tunnel that exposes only /api/ical/.
# Without it the links use APP_URL. See docs/deployment.md.
ICAL_PUBLIC_URL=""
# Failed pushes of one booking's event before giving up on it (shown as
# failed, retried by hand). Default 8.
GOOGLE_SYNC_MAX_ATTEMPTS=""
# Optional public https URL of this app for Google's push notifications
# (<url>/api/google/webhook). Leave empty when the app is LAN-only: polling
# then picks up changes on its own.
GOOGLE_WEBHOOK_URL=""
# Timed Google events shorter than this many hours are not imported as
# blocks, so meetings don't block nights. Default 12.
GOOGLE_IMPORT_MIN_TIMED_HOURS=""

# --- Security ----------------------------------------------------------------
# "true" only behind a reverse proxy that sets X-Forwarded-For: rate limits
# on sign-in and the webhook then count per client address.
TRUST_PROXY_HEADERS=""

# --- Logging ----------------------------------------------------------------
# Minimum level for the JSON logs on stdout: trace, debug, info, warn, error
# or fatal. Optional; defaults to info.
LOG_LEVEL="info"

# --- Error tracking -----------------------------------------------------------
# DSN of a GlitchTip or Sentry project, e.g. http://<key>@glitchtip.lan/1.
# Error tracking is off while this is empty. Public (the DSN only allows
# submitting events) and inlined at build time, like every NEXT_PUBLIC_ value.
# In the browser the SDK loads lazily, right after the page starts, so it
# never slows a page down; an error in that first moment goes unreported.
# Without a DSN the browser never downloads it.
NEXT_PUBLIC_SENTRY_DSN=""
# Optional; defaults to NODE_ENV.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=""

# Set to "true" to enable GET /api/debug/error, which throws on purpose so the
# tracker can be checked end to end. Leave off otherwise.
ENABLE_ERROR_TEST_ROUTE="false"

# Build time only - source map upload and release creation. Upload is skipped
# unless SENTRY_AUTH_TOKEN is set. SENTRY_URL is the self-hosted instance.
# The release name defaults to SENTRY_RELEASE, then CI_COMMIT_SHA, then git.
# SENTRY_URL=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""
# SENTRY_RELEASE=""

# --- Receipts -----------------------------------------------------------------
# Where receipts on transactions are stored. Optional; default ./data/receipts.
# Production keeps them in the `receipts` volume (compose.prod.yml), which
# sets this itself.
RECEIPTS_DIR=""

# --- Backups ----------------------------------------------------------------
# Read by docker-compose.yml for the `backup` service (`--profile backup`),
# not by the app. See docs/backup-and-restore.md for the whole procedure.
#
# Where backups are written on the Docker host. Must be OFF this machine to be
# worth anything: an NFS mount from a NAS or another Proxmox node (not SMB:
# the image needs hard links). Writable by uid 999.
BACKUP_HOST_DIR="./backups"
# When to back up: cron syntax or @daily / @every 12h. Evaluated in BACKUP_TZ.
BACKUP_SCHEDULE="@daily"
BACKUP_TZ="Europe/Berlin"
# Retention. Erased guests (DSGVO) stay in older backups until these expire,
# so the longest of them is how long an erasure takes to reach the backups.
BACKUP_KEEP_DAYS="7"
BACKUP_KEEP_WEEKS="4"
BACKUP_KEEP_MONTHS="6"
# Days a receipt deleted in the app stays in the receipts mirror (the
# `receipts-backup` service), so older dumps keep their receipts. Default 186.
BACKUP_RECEIPTS_KEEP_DAYS=""
# Push-monitor URLs (Uptime Kuma or Healthchecks) for alerting. The heartbeat
# is called after each successful backup; set the monitor to alert when it
# has heard nothing for 48 hours. The failure URL is called when one fails.
# Leave empty to disable.
BACKUP_HEARTBEAT_URL=""
BACKUP_FAILURE_URL=""

# --- Production server ----------------------------------------------------
# Only on the server, in the .env next to compose.prod.yml; leave commented
# out for development. docs/deployment.md explains each.
#
# Makes plain `docker compose` in this folder use the production file.
# COMPOSE_FILE="compose.prod.yml"
# Which extras run: "https" (Caddy, option A) and "backup" (the backups).
# COMPOSE_PROFILES="https,backup"
# The database password; generate one with: openssl rand -base64 24
# POSTGRES_PASSWORD="replace-me"
# The app's port on the server itself (127.0.0.1 only), for an SSH tunnel.
# APP_LOCAL_PORT="3000"
#
# Option A, https on your own domain (Caddy, certificate via DNS-01):
# APP_DOMAIN="vacation.example.com"
# ACME_EMAIL="you@example.com"
# CLOUDFLARE_API_TOKEN="replace-me"
# Behind Caddy, the app may trust the client address it passes on.
# TRUST_PROXY_HEADERS="true"

# Copy this file to `.env` and fill in the blanks.
#
# Every variable below is required. They are validated against a schema at
# boot (see src/env.ts) and the app refuses to start if any is missing or
# malformed, naming the offending variable.

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string. The host port matches the one docker-compose
# publishes, which is deliberately not 5432 so it cannot clash with a local
# PostgreSQL install.
DATABASE_URL="postgresql://vacation:vacation@localhost:5433/vacation_home"

# --- Authentication ---------------------------------------------------------
# Session signing key, at least 32 characters. Generate one with:
#   npx auth secret
AUTH_SECRET=""

# Google OAuth client credentials, from the Google Cloud console under
# APIs & Services -> Credentials. The same client is reused later for the
# Google Calendar scopes, so create it as a "Web application" client.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Application ------------------------------------------------------------
# Public base URL of this app. OAuth redirect URIs are derived from it, so it
# must match what is registered in the Google client.
APP_URL="http://localhost:3000"

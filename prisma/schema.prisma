// Database schema. Change it, then run `npm run migrate:dev -- --name <change>`
// to create a migration and regenerate the client.

generator client {
  provider = "prisma-client"
  // Generated into the source tree so the `@/generated/prisma` import resolves
  // like any other module. Ignored by git, rebuilt on `npm install`.
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A rental property. Deliberately minimal: "Data model and CRUD API for
/// properties" adds the address, timezone, currency, rates and the rest.
model Property {
  // Generated by the database, so rows inserted outside Prisma get one too.
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("properties")
}

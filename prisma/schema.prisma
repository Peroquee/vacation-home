// Database schema. Change it, then run `npm run migrate:dev -- --name <change>`
// to create a migration and regenerate the client.

generator client {
  provider = "prisma-client"
  // Generated into the source tree so the `@/generated/prisma` import resolves
  // like any other module. Ignored by git, rebuilt on `npm install`.
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A rental property. Everything else - bookings, blocks, finances - hangs
/// off one, even in a single-property setup.
///
/// Money is stored as integer minor units (cents), never floats; see
/// src/lib/format.ts. Relations added later that must not outlive a property
/// with history (bookings) use `onDelete: Restrict`, which is what makes the
/// DELETE endpoint refuse and point to archiving instead.
model Property {
  // Generated by the database, so rows inserted outside Prisma get one too.
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                    String
  address                 String?
  /// IANA timezone, e.g. "Europe/Lisbon". Check-in and check-out are
  /// calendar dates in this zone.
  timezone                String
  /// ISO 4217 code, e.g. "EUR". Every amount on this property is in it.
  currency                String    @db.Char(3)
  /// Defaults copied into each new booking; changing them never touches
  /// existing ones.
  defaultNightlyRateMinor Int       @default(0) @map("default_nightly_rate_minor")
  defaultCleaningFeeMinor Int       @default(0) @map("default_cleaning_fee_minor")
  /// "#rrggbb", used for the property's bookings on the calendar.
  color                   String    @db.Char(7)
  /// Set when archived: hidden from selectors, history kept. Null = active.
  archivedAt              DateTime? @map("archived_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  @@map("properties")
}

/// A guest, reused across repeat stays and offered in booking forms as a
/// typeahead. Personal data: never log it (src/lib/scrub.ts masks emails).
model Guest {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  /// Stored trimmed and lower-cased, so uniqueness is case-insensitive. One
  /// guest per address; optional, since some guests only leave a phone
  /// number (PostgreSQL allows any number of NULLs under a unique index).
  email     String?  @unique
  phone     String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("guests")
}

// --- Authentication (Auth.js) ------------------------------------------------
// The models and field names are the ones @auth/prisma-adapter expects; only
// the table and column names are mapped to this schema's snake_case.

/// Someone who has signed in. Who may sign in at all is decided by
/// AUTH_ALLOWED_EMAILS, checked at sign-in and on every request.
model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

/// A linked Google account. Holds the OAuth tokens - including the refresh
/// token that Google Calendar sync will use, so it is requested with
/// `access_type=offline` and kept current on every sign-in. Never log these.
model Account {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// A signed-in browser. The cookie holds `sessionToken`; deleting the row
/// signs that browser out.
model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Required by the adapter's interface; unused while Google is the only
/// provider (it serves email sign-in links).
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Database schema. Change it, then run `npm run migrate:dev -- --name <change>`
// to create a migration and regenerate the client.

generator client {
  provider = "prisma-client"
  // Generated into the source tree so the `@/generated/prisma` import resolves
  // like any other module. Ignored by git, rebuilt on `npm install`.
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A rental property. Everything else - bookings, blocks, finances - hangs
/// off one, even in a single-property setup.
///
/// Money is stored as integer minor units (cents), never floats; see
/// src/lib/format.ts. Relations added later that must not outlive a property
/// with history (bookings) use `onDelete: Restrict`, which is what makes the
/// DELETE endpoint refuse and point to archiving instead.
model Property {
  // Generated by the database, so rows inserted outside Prisma get one too.
  id                      String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                    String
  address                 String?
  /// IANA timezone, e.g. "Europe/Lisbon". Check-in and check-out are
  /// calendar dates in this zone.
  timezone                String
  /// ISO 4217 code, e.g. "EUR". Every amount on this property is in it.
  currency                String              @db.Char(3)
  /// Defaults copied into each new booking; changing them never touches
  /// existing ones.
  defaultNightlyRateMinor Int                 @default(0) @map("default_nightly_rate_minor")
  defaultCleaningFeeMinor Int                 @default(0) @map("default_cleaning_fee_minor")
  /// "#rrggbb", used for the property's bookings on the calendar.
  color                   String              @db.Char(7)
  /// Set when archived: hidden from selectors, history kept. Null = active.
  archivedAt              DateTime?           @map("archived_at")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")
  bookings                Booking[]
  blocks                  Block[]
  transactions            Transaction[]
  calendar                PropertyCalendar?
  calendarWatch           CalendarWatch?
  calendarSyncIssues      CalendarSyncIssue[]
  incomeAutomation        IncomeAutomation?
  bookingRules            BookingRules?
  listing                 PropertyListing?
  photos                  PropertyPhoto[]
  recurringExpenses       RecurringExpense[]
  icalFeeds               IcalFeed[]
  /// The secret in the URL of the property's outbound iCal feed
  /// (/api/ical/<token>); null while the feed is off.
  icalExportToken         String?             @unique @map("ical_export_token")
  /// The property's address on the public booking site: /stay/<slug>.
  /// Lowercase letters, digits and single hyphens; null until chosen.
  slug                    String?             @unique
  /// Shown on the public booking site. Off by default, and only possible
  /// with a slug; an archived property stays hidden whatever this says.
  publiclyListed          Boolean             @default(false) @map("publicly_listed")

  // Target of the transactions' (property, currency) foreign key, which keeps
  // a transaction in its property's currency.
  @@unique([id, currency])
  @@map("properties")
}

/// A guest, reused across repeat stays and offered in booking forms as a
/// typeahead. Personal data: never log it (src/lib/scrub.ts masks emails).
model Guest {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  /// Stored trimmed and lower-cased, so uniqueness is case-insensitive. One
  /// guest per address; optional, since some guests only leave a phone
  /// number (PostgreSQL allows any number of NULLs under a unique index).
  email     String?   @unique
  phone     String?
  notes     String?
  /// Set when the guest's personal data was erased (DSGVO Art. 17): the
  /// record stays, anonymised, because its bookings are accounting records.
  /// A purged guest is read-only and never found by search.
  purgedAt  DateTime? @map("purged_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  bookings  Booking[]

  @@index([name])
  @@map("guests")
}

// --- Bookings -----------------------------------------------------------------

enum BookingStatus {
  /// Asked about, not committed: does not block the dates.
  inquiry
  /// Committed: blocks the dates (see the availability rules).
  confirmed
  /// Kept for history; never blocks.
  cancelled

  @@map("booking_status")
}

enum BookingSource {
  direct
  airbnb
  booking_com @map("booking.com")
  other

  @@map("booking_source")
}

/// A stay at a property.
///
/// DATES: `checkIn` and `checkOut` are calendar dates in the property's
/// timezone, with no time of day. `checkOut` is EXCLUSIVE: the stay occupies
/// the nights from `checkIn` up to but not including `checkOut`, so the
/// departure day is free for the next guest to arrive. A stay from 14 to 18
/// July is 4 nights (14, 15, 16, 17) and does not overlap a stay starting on
/// 18 July. In SQL terms the stay is `daterange(check_in, check_out, '[)')`.
///
/// MONEY: integer minor units (cents) in `currency`, never floats. The
/// currency is copied from the property when the booking is made, so later
/// changes to the property never reinterpret existing amounts; likewise the
/// rate and fee are copied from the property's defaults and then belong to
/// the booking.
model Booking {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId       String        @map("property_id") @db.Uuid
  guestId          String        @map("guest_id") @db.Uuid
  checkIn          DateTime      @map("check_in") @db.Date
  /// Exclusive: the departure day, when the stay no longer occupies the night.
  checkOut         DateTime      @map("check_out") @db.Date
  status           BookingStatus @default(inquiry)
  source           BookingSource @default(direct)
  guestCount       Int           @default(1) @map("guest_count")
  nightlyRateMinor Int           @map("nightly_rate_minor")
  cleaningFeeMinor Int           @map("cleaning_fee_minor")
  /// Normally nights x nightly rate + cleaning fee, kept up to date by the
  /// API; `totalIsManual` marks a total set by hand, which is then left alone.
  totalAmountMinor Int           @map("total_amount_minor")
  totalIsManual    Boolean       @default(false) @map("total_is_manual")
  currency         String        @db.Char(3)
  notes            String?
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  // Restrict: a property or guest with bookings cannot be deleted (their
  // APIs answer 409 and suggest archiving instead).
  property      Property            @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  guest         Guest               @relation(fields: [guestId], references: [id], onDelete: Restrict)
  transactions  Transaction[]
  calendarLinks CalendarEventLink[]

  // Target of the transactions' (booking, property) foreign key, which keeps
  // a transaction's booking on the transaction's own property.
  @@unique([id, propertyId])
  @@index([propertyId, checkIn, checkOut])
  @@index([guestId])
  @@map("bookings")
}

// --- Blocks -------------------------------------------------------------------

enum BlockOrigin {
  /// Created in this app: maintenance, personal use.
  manual
  /// Imported from an event in the property's Google Calendar.
  google
  /// Imported from a booking platform's iCal feed (`feedId`).
  ical

  @@map("block_origin")
}

/// Dates a property cannot be booked that are not a booking: an owner block
/// (maintenance, personal use) or an event imported from Google Calendar.
/// Blocks affect availability exactly as confirmed bookings do.
///
/// DATES follow the booking rule: calendar dates in the property's timezone,
/// half-open. The block covers the nights from `startDate` up to but not
/// including `endDate`, so a block ending on the 18th leaves the 18th free for
/// an arrival. Google Calendar ends all-day events the same way, so their
/// dates map directly. A timed event must first be converted to calendar
/// dates in the property's timezone by the importer: every night it touches.
model Block {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId      String      @map("property_id") @db.Uuid
  startDate       DateTime    @map("start_date") @db.Date
  /// Exclusive, like a booking's check-out.
  endDate         DateTime    @map("end_date") @db.Date
  reason          String?
  origin          BlockOrigin @default(manual)
  /// The Google Calendar event a `google` block came from, or the iCal UID
  /// of an `ical` one; null for manual blocks. Unique per property, so a
  /// re-import updates instead of duplicating.
  externalEventId String?     @map("external_event_id")
  /// The iCal feed an `ical` block came from; its blocks go with it.
  feedId          String?     @map("feed_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  // Blocks have no life without their property.
  property      Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  feed          IcalFeed?           @relation(fields: [feedId], references: [id], onDelete: Cascade)
  calendarLinks CalendarEventLink[]

  @@unique([propertyId, externalEventId])
  @@index([propertyId, startDate, endDate])
  @@map("blocks")
}

// --- Google Calendar event links ----------------------------------------------

enum CalendarSyncState {
  /// The event needs creating or updating in Google.
  pending
  /// Google has the current version (`etag`).
  synced
  /// The last attempt failed; `lastError` says why, and it will be retried.
  failed
  /// The booking or block is gone: the Google event still needs deleting.
  pending_delete
  /// Failed GOOGLE_SYNC_MAX_ATTEMPTS times in a row: no longer retried on its
  /// own (dead letter) until retried by hand or the booking changes again.
  dead

  @@map("calendar_sync_state")
}

/// The identity mapping between a booking (or a manual block) and the Google
/// Calendar event pushed for it, so a re-run updates that event instead of
/// creating another.
///
/// `googleEventId` is chosen by the app before the first insert (see
/// src/lib/google/links.ts), so even a retried insert cannot duplicate.
///
/// DELETION: deleting the booking or block keeps the link, with its target
/// set to null and the state forced to `pending_delete` by a trigger, so the
/// remote event can still be cleaned up; the row is deleted once it is.
model CalendarEventLink {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId     String?           @map("booking_id") @db.Uuid
  blockId       String?           @map("block_id") @db.Uuid
  calendarId    String            @map("calendar_id")
  googleEventId String            @map("google_event_id")
  /// Google's version of the event as last written, for `If-Match`.
  etag          String?
  lastSyncedAt  DateTime?         @map("last_synced_at")
  syncState     CalendarSyncState @default(pending) @map("sync_state")
  /// A short, data-free description of the last failure (an error kind).
  lastError     String?           @map("last_error")
  /// Whose Google connection writes the event: the user who set up the
  /// property's calendar when the link was made. Null once that user is gone.
  userId        String?           @map("user_id") @db.Uuid
  /// Bumped on every change to sync; a push records success only if no newer
  /// change arrived meanwhile, so the latest version always gets written.
  changeSeq     Int               @default(0) @map("change_seq")
  /// Failed attempts in a row; the delay before the next grows with it.
  attempts      Int               @default(0)
  /// When this link started failing (the first failure in a row), for the
  /// "sync has been failing" banner; cleared on success.
  failingSince  DateTime?         @map("failing_since")
  /// When the sync worker may next pick this link up.
  nextAttemptAt DateTime          @default(now()) @map("next_attempt_at")
  /// A worker's lease: until then no other worker takes the link.
  claimedUntil  DateTime?         @map("claimed_until")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  block   Block?   @relation(fields: [blockId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([calendarId, googleEventId])
  /// One event per booking (or block) per calendar.
  @@unique([bookingId, calendarId])
  @@unique([blockId, calendarId])
  @@index([syncState, nextAttemptAt])
  @@map("calendar_event_links")
}

/// Inbound sync state for a property whose calendar is imported (GitLab
/// #72): where the last incremental list left off, and when to look again.
/// Changes are found by polling with Google's sync token; push notifications
/// through a webhook are optional (they need a public URL) and only make a
/// poll happen sooner.
model CalendarWatch {
  propertyId        String    @id @map("property_id") @db.Uuid
  /// The calendar the sync token belongs to; a different one starts afresh.
  calendarId        String    @map("calendar_id")
  /// Google's token for the next incremental list; null means a full list.
  syncToken         String?   @map("sync_token")
  nextPollAt        DateTime  @default(now()) @map("next_poll_at")
  lastPolledAt      DateTime? @map("last_polled_at")
  lastFullSyncAt    DateTime? @map("last_full_sync_at")
  /// Failed polls in a row; the delay before the next grows with it.
  attempts          Int       @default(0)
  lastError         String?   @map("last_error")
  claimedUntil      DateTime? @map("claimed_until")
  /// The push notification channel, when GOOGLE_WEBHOOK_URL is set.
  channelId         String?   @unique @map("channel_id")
  channelResourceId String?   @map("channel_resource_id")
  /// SHA-256 of the channel's secret token, which Google echoes back.
  channelTokenHash  String?   @map("channel_token_hash")
  channelExpiresAt  DateTime? @map("channel_expires_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([nextPollAt])
  @@map("calendar_watches")
}

enum CalendarSyncIssueKind {
  /// A Google event overlaps a confirmed booking, so it was not imported
  /// as a block: someone should look at it.
  inbound_overlap
  /// A booking platform's stay (iCal feed) overlaps a confirmed booking: a
  /// double booking, sold on the platform and here.
  ical_overlap

  @@map("calendar_sync_issue_kind")
}

/// Something sync could not settle on its own and shows for review
/// (GitLab #74). An issue resolves itself once its cause is gone (the event
/// moved or was deleted), or is dismissed by hand.
model CalendarSyncIssue {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId    String                @map("property_id") @db.Uuid
  kind          CalendarSyncIssueKind
  /// For `inbound_overlap`: the Google calendar and event.
  calendarId    String?               @map("calendar_id")
  googleEventId String?               @map("google_event_id")
  /// For `ical_overlap`: the feed and the event's UID in it.
  feedId        String?               @map("feed_id") @db.Uuid
  eventUid      String?               @map("event_uid")
  /// The confirmed bookings in the way, by id only.
  bookingIds    String[]              @map("booking_ids") @db.Uuid
  /// The nights the event would block.
  startDate     DateTime              @map("start_date") @db.Date
  endDate       DateTime              @map("end_date") @db.Date
  detectedAt    DateTime              @default(now()) @map("detected_at")
  resolvedAt    DateTime?             @map("resolved_at")
  /// "gone" (the conflict went away) or "dismissed".
  resolution    String?
  updatedAt     DateTime              @updatedAt @map("updated_at")

  property Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  feed     IcalFeed? @relation(fields: [feedId], references: [id], onDelete: Cascade)

  @@index([propertyId, resolvedAt])
  @@map("calendar_sync_issues")
}

/// The Google Calendar a property's bookings are pushed to (outbound sync,
/// GitLab #70), through the Google connection of the user who chose it.
model PropertyCalendar {
  propertyId   String   @id @map("property_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  calendarId   String   @map("calendar_id")
  /// The calendar's name in Google when chosen, for display.
  calendarName String?  @map("calendar_name")
  /// Push the property's bookings to the calendar.
  outbound     Boolean  @default(true)
  /// Import the calendar's other events as blocks (inbound sync, later).
  inbound      Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("property_calendars")
}

// --- Finance ------------------------------------------------------------------

enum TransactionType {
  income
  expense

  @@map("transaction_type")
}

/// A ledger category. The defaults are created by the migration as system
/// categories: they can be renamed, recoloured and hidden, but never deleted,
/// since the app relies on them (booking income automation finds its category
/// by `systemKey`). User categories may be deleted when unused.
model Category {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  type              TransactionType
  /// "#rrggbb", used by the expense breakdown chart.
  color             String             @db.Char(7)
  isSystem          Boolean            @default(false) @map("is_system")
  /// Stable identifier of a system category, e.g. "booking_income"; null for
  /// user categories.
  systemKey         String?            @unique @map("system_key")
  /// Hidden categories are not offered for new transactions; existing ones
  /// keep them.
  hidden            Boolean            @default(false)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  transactions      Transaction[]
  recurringExpenses RecurringExpense[]

  // Target of the transactions' (category, type) foreign key, which keeps a
  // transaction's category of the transaction's own type.
  // Names are also unique per type ignoring case and surrounding spaces:
  // an expression index the migration adds, which Prisma cannot express.
  @@unique([id, type])
  @@map("categories")
}

/// The parts of a confirmed booking that become income automatically.
enum GeneratedEntry {
  /// The total less the cleaning fee, in "Booking income".
  booking_accommodation
  /// The cleaning fee, in "Cleaning fees".
  booking_cleaning

  @@map("generated_entry")
}

enum CancelledIncome {
  /// Delete the generated entries.
  delete
  /// Keep them, with the amount set to zero.
  zero

  @@map("cancelled_income")
}

/// Per property: whether confirmed bookings create their income entries.
model IncomeAutomation {
  propertyId String          @id @map("property_id") @db.Uuid
  enabled    Boolean         @default(true)
  /// What happens to generated entries when the booking is cancelled.
  onCancel   CancelledIncome @default(delete) @map("on_cancel")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("income_automation")
}

/// Guard rails for stays at a property (GitLab #107), checked by
/// src/lib/booking-rules: hard limits on the public site, warnings in the
/// owner's own booking form. No row means no rules.
model BookingRules {
  propertyId      String   @id @map("property_id") @db.Uuid
  minNights       Int      @default(1) @map("min_nights")
  /// Null: no limit beyond the app's own 365 nights.
  maxNights       Int?     @map("max_nights")
  /// Days between today (in the property's timezone) and check-in at least.
  minLeadDays     Int      @default(0) @map("min_lead_days")
  /// How many days ahead check-in may be; null for no limit.
  horizonDays     Int?     @map("horizon_days")
  /// ISO weekdays (1 = Monday ... 7 = Sunday) a stay may start on, sorted;
  /// empty for any day.
  checkInWeekdays Int[]    @default([]) @map("check_in_weekdays")
  /// Free nights required between two stays.
  bufferDays      Int      @default(0) @map("buffer_days")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("booking_rules")
}

/// What guests see of a property on the public booking site (GitLab #106).
/// Text comes in both languages; the page shows the visitor's, falling back
/// to the other. Never the exact address: `location` is a town or region.
model PropertyListing {
  propertyId    String   @id @map("property_id") @db.Uuid
  titleEn       String   @default("") @map("title_en")
  titleDe       String   @default("") @map("title_de")
  descriptionEn String   @default("") @map("description_en")
  descriptionDe String   @default("") @map("description_de")
  houseRulesEn  String   @default("") @map("house_rules_en")
  houseRulesDe  String   @default("") @map("house_rules_de")
  /// Town or region, e.g. "Malcesine, Lake Garda".
  location      String   @default("")
  maxGuests     Int?     @map("max_guests")
  bedrooms      Int?
  bathrooms     Int?
  /// Keys from src/lib/listing/values.ts (AMENITIES), sorted.
  amenities     String[] @default([])
  /// "HH:MM" in the property's timezone.
  checkInTime   String?  @map("check_in_time")
  checkOutTime  String?  @map("check_out_time")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_listings")
}

/// A photo of a property for its public page (GitLab #106). Only re-encoded
/// sizes are stored (WebP, no metadata), never the upload itself; they are
/// files in the content-addressed store (src/lib/files/store.ts).
model PropertyPhoto {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId String              @map("property_id") @db.Uuid
  /// Display order; the lowest is the cover photo.
  position   Int
  altEn      String              @default("") @map("alt_en")
  altDe      String              @default("") @map("alt_de")
  createdAt  DateTime            @default(now()) @map("created_at")
  property   Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  sizes      PropertyPhotoSize[]

  @@index([propertyId, position])
  @@map("property_photos")
}

/// One stored size of a photo.
model PropertyPhotoSize {
  photoId String        @map("photo_id") @db.Uuid
  width   Int
  height  Int
  /// The file's name in the store: its SHA-256.
  sha256  String        @db.Char(64)
  photo   PropertyPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@id([photoId, width])
  @@index([sha256])
  @@map("property_photo_sizes")
}

enum RecurrenceInterval {
  monthly
  quarterly
  annual

  @@map("recurrence_interval")
}

/// A rule for an expense that repeats - insurance, internet, utilities -
/// from which a scheduled job creates one transaction per period (GitLab #81).
///
/// Occurrence n falls on `startDate` plus n intervals, on the same day of
/// the month, or the month's last day when it is shorter (31 Jan, 28 Feb,
/// 31 Mar ...). `nextOccurrence` is the index of the next one to create.
model RecurringExpense {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId     String             @map("property_id") @db.Uuid
  categoryId     String             @map("category_id") @db.Uuid
  /// Always "expense"; part of the category foreign key, like on transactions.
  type           TransactionType    @default(expense)
  amountMinor    Int                @map("amount_minor")
  currency       String             @db.Char(3)
  interval       RecurrenceInterval
  startDate      DateTime           @map("start_date") @db.Date
  /// The last day an occurrence may fall on; null for no end.
  endDate        DateTime?          @map("end_date") @db.Date
  description    String?
  nextOccurrence Int                @default(0) @map("next_occurrence")
  /// Set while paused: nothing is created, and the periods missed meanwhile
  /// are skipped on resuming.
  pausedAt       DateTime?          @map("paused_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  property     Property      @relation(fields: [propertyId, currency], references: [id, currency], onDelete: Cascade, onUpdate: Restrict)
  category     Category      @relation(fields: [categoryId, type], references: [id, type], onDelete: Restrict, onUpdate: Restrict)
  transactions Transaction[]

  @@index([propertyId])
  @@map("recurring_expenses")
}

/// An income or expense entry in the ledger, optionally linked to a booking.
///
/// MONEY: `amountMinor` is a positive integer of minor units in `currency`;
/// `type` gives the direction. DATE: a calendar date, like booking dates.
model Transaction {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId         String          @map("property_id") @db.Uuid
  /// Optional. When set, the booking belongs to the same property (enforced).
  bookingId          String?         @map("booking_id") @db.Uuid
  type               TransactionType
  categoryId         String          @map("category_id") @db.Uuid
  amountMinor        Int             @map("amount_minor")
  currency           String          @db.Char(3)
  date               DateTime        @db.Date
  description        String?
  isRecurring        Boolean         @default(false) @map("is_recurring")
  /// Set on income generated from a confirmed booking (GitLab #80): which
  /// part of it this is. At most one of each per booking.
  generated          GeneratedEntry?
  /// Set when someone edited a generated entry by hand: automation leaves it
  /// alone from then on (and does not add another in its place).
  detachedAt         DateTime?       @map("detached_at")
  /// The recurring expense rule that created this entry, if any (GitLab #81).
  /// Kept as history when the rule is deleted.
  recurringExpenseId String?         @map("recurring_expense_id") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  // Composite keys hold three rules, and never cascade (onUpdate: Restrict):
  // the amount is in the property's currency, the category has the
  // transaction's type, and the booking is on the transaction's property.
  property Property @relation(fields: [propertyId, currency], references: [id, currency], onDelete: Restrict, onUpdate: Restrict)
  category Category @relation(fields: [categoryId, type], references: [id, type], onDelete: Restrict, onUpdate: Restrict)
  booking  Booking? @relation(fields: [bookingId, propertyId], references: [id, propertyId], onDelete: Restrict, onUpdate: Restrict)

  recurringExpense RecurringExpense?       @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)
  attachments      TransactionAttachment[]

  @@unique([bookingId, generated])
  /// One entry per rule and period: a re-run or catch-up never doubles one.
  @@unique([recurringExpenseId, date])
  @@index([propertyId, date])
  @@index([bookingId])
  @@index([categoryId])
  @@map("transactions")
}

// --- Google Calendar --------------------------------------------------------------

enum GoogleConnectionStatus {
  connected
  /// Google refused the refresh token: access was revoked or expired. The
  /// user must reconnect; nothing is synced until then.
  disconnected

  @@map("google_connection_status")
}

/// A user's grant of Google Calendar access, requested separately from
/// sign-in (incremental authorisation, from the settings page). The tokens
/// are encrypted at rest (src/lib/secrets.ts); never log them.
model GoogleConnection {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String                 @unique @map("user_id") @db.Uuid
  /// The Google account granting access (its `sub`) - not necessarily the
  /// one the user signs in with - and its address, to show which it is.
  googleAccountId       String                 @map("google_account_id")
  googleEmail           String?                @map("google_email")
  scope                 String
  refreshTokenEncrypted String                 @map("refresh_token_encrypted")
  accessTokenEncrypted  String?                @map("access_token_encrypted")
  accessTokenExpiresAt  DateTime?              @map("access_token_expires_at")
  status                GoogleConnectionStatus @default(connected)
  /// Why it is disconnected, e.g. "revoked". Never a token or a Google
  /// error body.
  disconnectedReason    String?                @map("disconnected_reason")
  connectedAt           DateTime               @default(now()) @map("connected_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("google_connections")
}

// --- Audit ----------------------------------------------------------------------

/// That something happened, when, and who did it - never the data involved.
/// Append-only: written by the app, never updated or deleted by it.
model AuditEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// What happened, e.g. "guest.purged".
  action      String
  /// The kind and id of what it happened to; the id carries no personal data.
  subjectType String   @map("subject_type")
  subjectId   String   @map("subject_id") @db.Uuid
  /// The signed-in user who did it, if any. Not a relation: the trail must
  /// outlive the user's account.
  actorUserId String?  @map("actor_user_id") @db.Uuid
  /// Facts about the event, such as counts - never personal data.
  details     Json     @default("{}")
  occurredAt  DateTime @default(now()) @map("occurred_at")

  @@index([subjectType, subjectId])
  @@map("audit_events")
}

// --- Authentication (Auth.js) ------------------------------------------------
// The models and field names are the ones @auth/prisma-adapter expects; only
// the table and column names are mapped to this schema's snake_case.

/// Someone who has signed in. Who may sign in at all is decided by
/// AUTH_ALLOWED_EMAILS, checked at sign-in and on every request.
model User {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String?
  email             String?             @unique
  emailVerified     DateTime?           @map("email_verified")
  image             String?
  accounts          Account[]
  sessions          Session[]
  google            GoogleConnection?
  calendarLinks     CalendarEventLink[]
  propertyCalendars PropertyCalendar[]
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@map("users")
}

/// The Google account a user signs in with. Sign-in only identifies the
/// user, so no tokens are kept here (the token columns exist for the
/// adapter and stay empty); Google Calendar access is a separate,
/// encrypted GoogleConnection.
model Account {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// A signed-in browser. The cookie holds `sessionToken`; deleting the row
/// signs that browser out.
model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Required by the adapter's interface; unused while Google is the only
/// provider (it serves email sign-in links).
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// --- iCal feeds ----------------------------------------------------------------

/// A booking platform's iCal export (Airbnb, Booking.com, ...) for one
/// property. Its events become read-only `ical` blocks (src/lib/ical).
model IcalFeed {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId    String    @map("property_id") @db.Uuid
  /// Shown on its blocks, e.g. "Airbnb".
  name          String
  /// The platform's export URL. It carries the platform's secret token, so
  /// the API only ever shows its host.
  url           String
  /// When the feed is next fetched.
  nextFetchAt   DateTime  @default(now()) @map("next_fetch_at")
  lastFetchedAt DateTime? @map("last_fetched_at")
  /// The last successful fetch (a 304 counts).
  lastSuccessAt DateTime? @map("last_success_at")
  /// Why the last fetch failed, as a code (src/lib/ical/fetch.ts); null after a success.
  lastError     String?   @map("last_error")
  /// Events in the last successful fetch that block dates.
  eventCount    Int       @default(0) @map("event_count")
  /// Of those, the ones that overlap a confirmed booking: each is an open
  /// `ical_overlap` issue instead of a block.
  conflictCount Int       @default(0) @map("conflict_count")
  /// HTTP validators, so an unchanged feed costs a 304.
  etag          String?
  lastModified  String?   @map("last_modified")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  property Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  blocks   Block[]
  issues   CalendarSyncIssue[]

  @@index([propertyId])
  @@index([nextFetchAt])
  @@map("ical_feeds")
}

// --- Receipts --------------------------------------------------------------------

/// A receipt on a transaction (GitLab #82): a PDF or photo kept as a file in
/// the receipts volume (RECEIPTS_DIR), named by its SHA-256, so identical
/// uploads share one file. Accounting records: guest erasure leaves them
/// alone; deleting the transaction deletes them, and a daily job removes
/// files nothing points to (src/lib/finance/receipts.ts).
model TransactionAttachment {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId   String   @map("transaction_id") @db.Uuid
  /// The name it was uploaded with, for downloads.
  fileName        String   @map("file_name")
  /// Checked from the file's own bytes, not the browser's word.
  mediaType       String   @map("media_type")
  size            Int
  sha256          String   @db.Char(64)
  /// A small JPEG preview made in the browser, for images; null for PDFs
  /// and HEIC.
  thumbnailSha256 String?  @map("thumbnail_sha256") @db.Char(64)
  createdAt       DateTime @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([sha256])
  @@map("transaction_attachments")
}
